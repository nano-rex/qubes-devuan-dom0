## arg 1:  the new package version
post_install() {
  sv --global --no-reload preset pipewire.service pipewire.socket wireplumber.service || :
}

post_upgrade() {
  post_install
}

## arg 1:  the old package version
pre_remove() {
  sv --global --no-reload disable pipewire.service pipewire.socket wireplumber.service || :
}
