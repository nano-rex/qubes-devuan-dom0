#!/bin/sh
set -eu

QUBES_XML=${QUBES_XML:-/var/lib/qubes/qubes.xml}
QUBES_AUTOSTART_DELAY=${QUBES_AUTOSTART_DELAY:-2}
QUBES_AUTOSTART_ONESHOT=${QUBES_AUTOSTART_ONESHOT:-0}
QVM_START_CMD=${QVM_START_CMD:-/usr/bin/qvm-start}

wait_for_qubes_xml() {
    while [ ! -s "$QUBES_XML" ]; do
        sleep 1
    done
}

collect_autostart_vms() {
    QUBES_XML="$QUBES_XML" python3 <<'PY'
import xml.etree.ElementTree as ET
import os

path = os.environ["QUBES_XML"]
try:
    tree = ET.parse(path)
except (ET.ParseError, FileNotFoundError):
    exit(0)

names = []
for dom in tree.findall("domain"):
    name = dom.find("name")
    if name is None or not name.text:
        continue
    autostart = dom.find("autostart")
    if autostart is None or not autostart.text:
        continue
    val = autostart.text.strip().lower()
    if val not in {"1", "true", "yes", "on"}:
        continue
    names.append(name.text.strip())
print("\n".join(names))
PY
}

autostart_vms() {
    collect_autostart_vms | while IFS= read -r vm; do
        [ -z "$vm" ] && continue
        "$QVM_START_CMD" --skip-if-running "$vm" || true
    done
}

wait_for_qubes_xml
# Delay slightly to give qubesd time to prepare
sleep "$QUBES_AUTOSTART_DELAY"

autostart_vms
if [ "$QUBES_AUTOSTART_ONESHOT" = "1" ]; then
    exit 0
fi
exec sleep infinity
