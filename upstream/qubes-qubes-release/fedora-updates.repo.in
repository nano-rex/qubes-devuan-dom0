[updates]
name=antiX %FCREL% - x86_64 - Updates
#baseurl=http://download.antixproject.org/pub/antix/linux/updates/%FCREL%/x86_64/
metalink=https://mirrors.antixproject.org/metalink?repo=updates-released-f%FCREL%&arch=x86_64
skip_if_unavailable=False
enabled=1
enablegroups=0
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-antix-%FCREL%-primary

