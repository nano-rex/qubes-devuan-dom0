[antix]
name=antiX %FCREL% - x86_64
#baseurl=http://download.antixproject.org/pub/antix/linux/releases/%FCREL%/Everything/x86_64/os/
metalink=https://mirrors.antixproject.org/metalink?repo=antix-%FCREL%&arch=x86_64
skip_if_unavailable=False
enabled=1
enablegroups=0
metadata_expire=7d
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-antix-%FCREL%-primary

