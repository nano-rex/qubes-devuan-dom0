# Copy to /etc/antix-qubes/host-update-route.env or set UPDATE_ROUTE_CONFIG.

# Route table used for marked update traffic.
ROUTE_TABLE_ID=300
RULE_PRIORITY=300
MARK_HEX=0x51

# Keep host primary networking independent by default.
# When APT_ONLY=1, only traffic from _apt to tcp/80,443 is rerouted.
APT_ONLY=1

# Host -> sys-firewall update path.
FIREWALL_GATEWAY_IP=10.137.1.2
FIREWALL_GATEWAY_DEV=br-fw-net

# Host -> sys-whonix update path.
WHONIX_GATEWAY_IP=10.137.2.2
WHONIX_GATEWAY_DEV=br-whonix-host
