#!/usr/bin/env python3
import os
import shutil
import subprocess
import sys


def parse_preserve_env(arg):
    if arg == "--preserve-env":
        return []
    if arg.startswith("--preserve-env="):
        return [v for v in arg.split("=", 1)[1].split(",") if v]
    return None


def can_use_doas(doas_path):
    if not doas_path:
        return False
    try:
        subprocess.run(
            [doas_path, "true"],
            check=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except subprocess.CalledProcessError:
        return False
    except OSError:
        return False
    return True


def main():
    env_vars = []
    preserve_all = False
    args = []
    it = iter(sys.argv[1:])
    for arg in it:
        preserved = parse_preserve_env(arg)
        if preserved is not None:
            env_vars.extend(preserved)
            continue
        if arg == "-E":
            preserve_all = True
            continue
        args.append(arg)

    if not args:
        sys.exit("sudo shim: no command provided")

    if env_vars or preserve_all:
        env_cmd = ["env"]
        if preserve_all:
            for key, value in os.environ.items():
                env_cmd.append(f"{key}={value}")
        else:
            for var in env_vars:
                if var not in os.environ:
                    continue
                env_cmd.append(f"{var}={os.environ[var]}")
    else:
        env_cmd = []

    doas_path = shutil.which("doas")
    sudo_path = shutil.which("sudo") or "sudo"
    use_doas = can_use_doas(doas_path)
    root_cmd = [doas_path] if use_doas else [sudo_path]

    cmd = env_cmd + root_cmd + args

    os.execvp(cmd[0], cmd)


if __name__ == "__main__":
    main()
